# Absolute path on the Docker host to the Obsidian vault.
OBSIDIAN_VAULT_PATH=/absolute/path/to/ObsidianVault

# Existing PostgreSQL instance published by the host on port 5432.
# Compose sets the in-container host to host.docker.internal.
POSTGRES_USER=cerebro
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=cerebro
POSTGRES_MIN_POOL_SIZE=1
POSTGRES_MAX_POOL_SIZE=10

# Ollama must be reachable from the containers. Pull both models before use.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma4
EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=ollama

# Telegram long-polling bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_REMINDER_TIME=09:00

# Required for direct audio/ogg multimodal answer evaluation.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

API_PORT=8000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
